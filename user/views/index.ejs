<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
   
    <div class="w-full h-screen bg-zinc-900 text-white p-10">
        <h3 class="text-2xl mb-3">Register User</h3>
    <form method ="post" action="/register">

        <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none"type="text" placeholder="name" name="name">
        <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none" type="email" placeholder="email" name="email">
        <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none"type="address" placeholder="address" name="address">
        <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none"type="number" placeholder="phone" name="phone">
        <input class="px-5 py-2 rounded-md bg-blue-500" type="submit" value="Register">

    </form>
    </div>
   
</body>
</html>